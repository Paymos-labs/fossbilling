{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ labels.refund_panel_title }}{% endblock %}

{% block content %}
<div class="card" id="paymos-refunds-card">
    <div class="card-header">
        <h3 class="card-title">{{ labels.refund_panel_title }}</h3>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end mb-4">
            <div class="col-auto">
                <label class="form-label" for="paymos-refund-invoice-id">{{ labels.refund_invoice_id_label }}</label>
                <input type="number" min="1" step="1" class="form-control" id="paymos-refund-invoice-id" name="invoice_id" value="{{ invoice_id > 0 ? invoice_id : '' }}" required>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary">{{ labels.refund_load_button }}</button>
            </div>
        </form>

        <input type="hidden" id="paymos-refund-csrf" value="{{ csrf_token }}">

        {% if panel_error %}
            <div class="alert alert-danger" role="alert">{{ panel_error }}</div>
        {% endif %}

        {% if panel %}
            <div id="paymos-refunds" data-invoice-id="{{ panel.invoice_id }}">
                <div class="mb-3">
                    <strong>#{{ panel.invoice_id }}</strong>
                    {% if panel.amount and panel.currency %}
                        — <span>{{ panel.amount }} {{ panel.currency }}</span>
                    {% endif %}
                    {% if panel.environment %}
                        <span class="badge bg-info ms-1">{{ panel.environment }}</span>
                    {% endif %}
                </div>

                {% if not panel.refunds_capable %}
                    <div class="alert alert-warning">{{ labels.refund_reconnect_hint }}</div>
                {% endif %}

                {% if panel.intents is not empty %}
                    <div class="table-responsive mb-3">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>{{ labels.refund_label_operation }}</th>
                                    <th>{{ labels.refund_label_type }}</th>
                                    <th>{{ labels.refund_label_cash_status }}</th>
                                    <th>{{ labels.refund_label_billing_record }}</th>
                                    <th>{{ labels.refund_label_amount }}</th>
                                    <th>{{ labels.refund_label_review_reason }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in panel.intents %}
                                    <tr>
                                        <td><code>{{ item.operation_id }}</code></td>
                                        <td><code>{{ item.mode }}</code></td>
                                        <td><code>{{ item.cash_state }}</code></td>
                                        <td><code>{{ item.projection_state }}</code></td>
                                        <td>{% if item.amount %}<code>{{ item.amount }} {{ item.asset }}</code>{% endif %}</td>
                                        <td>{% if item.review_reason %}<code>{{ item.review_reason }}</code>{% else %}{{ item.status_text }}{% endif %}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                {% if panel.external_refunds is not empty %}
                    <h4 class="h6 mt-3">{{ labels.refund_external_label }}</h4>
                    <ul class="list-group mb-3">
                        {% for ext in panel.external_refunds %}
                            <li class="list-group-item">
                                <code>{{ ext.withdrawal_id }}</code>
                                · <code>{{ ext.mode }}</code>
                                · <code>{{ ext.status }}</code>
                                · <code>{{ ext.amount }} {{ ext.asset }}</code>
                                {% if ext.review_reason %}· <span class="text-danger">{{ ext.review_reason }}</span>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if panel.intents is empty and panel.external_refunds is empty %}
                    <p class="text-muted">{{ labels.refund_empty }}</p>
                {% endif %}

                <div class="d-flex gap-2 flex-wrap" id="paymos-refund-actions">
                    {% if panel.can_refund_full %}
                        <button type="button" class="btn btn-danger paymos-refund-action" data-mode="full" data-token="{{ panel.tokens.full }}">
                            {{ labels.refund_button_full }}
                        </button>
                    {% endif %}
                    {% if panel.can_refund_overpayment %}
                        <button type="button" class="btn btn-warning paymos-refund-action" data-mode="overpayment" data-token="{{ panel.tokens.overpayment }}">
                            {{ labels.refund_button_overpayment }}
                        </button>
                    {% endif %}
                </div>

                <div id="paymos-refund-error" class="mt-3" role="alert"></div>
            </div>
        {% endif %}
    </div>
</div>

<script>
(function () {
    var root = document.getElementById('paymos-refunds');
    if (!root) {
        return;
    }
    var invoiceId = Number(root.getAttribute('data-invoice-id') || '0');
    var csrfInput = document.getElementById('paymos-refund-csrf');
    var errorEl = document.getElementById('paymos-refund-error');
    var fallbackError = {{ labels.refund_failed|json_encode|raw }};

    document.querySelectorAll('.paymos-refund-action').forEach(function (button) {
        button.addEventListener('click', function () {
            button.disabled = true;
            errorEl.innerHTML = '';
            var csrfToken = csrfInput ? csrfInput.value : '';
            var payload = {
                invoice_id: invoiceId,
                mode: button.getAttribute('data-mode'),
                request_token: button.getAttribute('data-token'),
                CSRFToken: csrfToken
            };

            fetch({{ api_refund_submit|json_encode|raw }}, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify(payload)
            }).then(function (res) {
                return res.json().then(function (json) {
                    if (!res.ok || (json && json.error)) {
                        throw new Error((json && json.error && json.error.message) ? json.error.message : fallbackError);
                    }
                    window.location.reload();
                });
            }).catch(function (err) {
                var alertBox = document.createElement('div');
                alertBox.className = 'alert alert-danger paymos-refund-error';
                alertBox.textContent = err.message || fallbackError;
                errorEl.appendChild(alertBox);
                button.disabled = false;
            });
        });
    });
})();
</script>
{% endblock %}
